{
  "manifest_version": 3,
  "name": "归拢 · 新标签页",
  "version": "1.0.0",
  "description": "把你的标签页归拢到一处：按域名分组、一键关干净、没看完的先存起来。",
  "permissions": ["tabs", "activeTab", "storage", "topSites", "favicon", "search"],
  "chrome_url_overrides": { "newtab": "index.html" },
  "background": { "service_worker": "background.js" },
  "commands": {
    "open-dashboard": {
      "suggested_key": {
        "default": "Ctrl+Shift+1",
        "mac": "Command+Shift+1"
      },
      "description": "呼出 / 聚焦归拢仪表盘"
    }
  },
  "action": {
    "default_title": "归拢",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
